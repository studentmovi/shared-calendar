{
  "expo": {
    "name": "Syncro",
    "slug": "syncro",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-syncro.png",
    "scheme": "syncro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-syncro.png"
    },
    "android": {
      "package": "com.studentmoviecorp.syncro",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-syncro.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo-syncro.png"
    },
    "plugins": [
      "expo-router",
      "expo-calendar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-syncro.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f4ed9c44-ecef-4b8c-955a-183b68d09c9d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f4ed9c44-ecef-4b8c-955a-183b68d09c9d"
    }
  }
}
